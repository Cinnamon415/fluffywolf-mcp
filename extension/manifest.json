{
  "manifest_version": 2,
  "name": "FluffyWolf MCP",
  "version": "1.3.0",
  "description": "Connects Firefox-based browsers to local MCP servers so AI agents can drive the tabs you allow.",
  "browser_specific_settings": {
    "gecko": {
      "id": "fluffywolf-mcp@local",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "tabs",
    "<all_urls>",
    "storage",
    "sessions"
  ],
  "content_security_policy": "script-src 'self' 'unsafe-eval'; object-src 'self';",
  "background": {
    "scripts": [
      "config.js",
      "policy.js",
      "background.js",
      "events.js",
      "gate.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_action": {
    "default_title": "FluffyWolf MCP",
    "default_icon": "icons/icon-locked.svg",
    "default_popup": "popup.html"
  },
  "devtools_page": "devtools.html",
  "page_action": {
    "default_title": "FluffyWolf MCP",
    "default_icon": "icons/pa-off.svg",
    "browser_style": false
  }
}
